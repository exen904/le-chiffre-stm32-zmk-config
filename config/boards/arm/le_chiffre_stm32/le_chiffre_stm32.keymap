 *
 * Belegung übertragen von der Bad Wings V2 (bw2.keymap).
 *
 * Positionen 0-29 (3x10 Alphas) sind auf beiden Boards identisch, daher
 * sind alle Combos 1:1 übernommen.
 *
 * Daumen: Bad Wings hat 3+3, Le Chiffre (transform_with_encoder) hat 2+2
 * plus die Encoder-Taste in der Mitte (Position 34):
 *
 *   Bad Wings:  30 DEL | 31 TAB/NUM | 32 SPACE    33 ENTER | 34 NAV | 35 BSPC
 *   Le Chiffre:          30 TAB/NUM | 31 SPACE    32 ENTER | 33 NAV/BSPC
 *                                       34 Encoder-Taste (Mute)
 *
 *   - DEL (äußerer linker Daumen) entfällt, liegt weiterhin auf NUM (Pos. 20)
 *   - &mo 2 + BSPC werden zu &lt 2 BSPC zusammengelegt (wie bisher am Chiffre)
 *   - Mac: &lt 5 ESC + BSPC -> &lt 5 BSPC, ESC über Combo 0+1
 *
 * Falls die äußeren Daumentasten bestückt sind: in der .dts
 * zmk,matrix_transform = &transform_36key_with_encoder setzen, dann lässt
 * sich die Bad-Wings-Belegung 1:1 übernehmen.
 */

#include "keys_de.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE     0
#define NUM      1
#define NAV      2
#define BASE_MAC 3
#define NUM_MAC  4
#define SYM_MAC  5
#define BT       6

// Positionen für hold-trigger-key-positions
#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 25 26 27 28 29
#define THUMBS 30 31 32 33 34

&mt {
    quick-tap-ms = <100>;
    require-prior-idle-ms = <100>;   // entspricht global-quick-tap + quick-tap-ms
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
            slow-release;
        };

        combo_caps {
            timeout-ms = <50>;
            key-positions = <15 19>;
            bindings = <&caps_word>;
        };

        combo_singlequote {
            timeout-ms = <75>;
            key-positions = <7 8>;
            bindings = <&kp DE_SQT>;
        };

        combo_doublequote {
            timeout-ms = <75>;
            key-positions = <8 9>;
            bindings = <&kp DE_DQT>;
        };

        combo_minus {
            timeout-ms = <50>;
            key-positions = <17 18>;
            bindings = <&kp DE_MINUS>;
            slow-release;
        };

        combo_plus {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp DE_PLUS>;
            slow-release;
        };

        combo_equal {
            timeout-ms = <50>;
            key-positions = <26 27>;
            bindings = <&kp DE_EQUAL>;
            slow-release;
        };

        combo_underscore {
            timeout-ms = <50>;
            key-positions = <16 17 18>;
            bindings = <&kp DE_UNDER>;
        };

        combo_worddelete {
            timeout-ms = <50>;
            key-positions = <18 19>;
            bindings = <&kp LC(BSPC)>;
        };

        combo_questionmark {
            timeout-ms = <50>;
            key-positions = <27 28>;
            bindings = <&kp DE_QMARK>;
        };

        combo_worddelete_mac {
            bindings = <&kp RA(BACKSPACE)>;
            key-positions = <18 19>;
            layers = <BASE_MAC>;
        };

        combo_enter {
            bindings = <&kp ENTER>;
            key-positions = <16 18>;
        };
    };

    behaviors {
        hl: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "homerow mods left";
            #binding-cells = <2>;
            require-prior-idle-ms = <100>;
            flavor = "balanced";
            tapping-term-ms = <155>;

            bindings = <&kp>, <&kp>;

            // gegenüberliegende Hand + alle Daumen
            hold-trigger-key-positions = <KEYS_R THUMBS>;
        };

        hr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "homerow mods right";
            #binding-cells = <2>;
            require-prior-idle-ms = <100>;
            flavor = "balanced";
            tapping-term-ms = <155>;

            bindings = <&kp>, <&kp>;

            // gegenüberliegende Hand + alle Daumen
            hold-trigger-key-positions = <KEYS_L THUMBS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";

            bindings = <
            &kp Q          &kp DE_W       &kp DE_E        &kp DE_R        &kp DE_T     &kp DE_Z   &kp DE_U        &kp DE_I        &kp DE_O       &kp DE_P
            &hl LGUI DE_A  &hl LALT DE_S  &hl LCTRL DE_D  &hl LSHFT DE_F  &kp DE_G     &kp DE_H   &hr RSHFT DE_J  &hr RCTRL DE_K  &hr RALT DE_L  &hr RGUI DE_SEMI
            &kp DE_Y       &kp DE_X       &kp DE_C        &kp DE_V        &kp DE_B     &kp DE_N   &kp DE_M        &kp DE_COMMA    &kp DE_DOT     &kp DE_FSLH
                                                          &lt NUM TAB     &kp SPACE    &kp ENTER  &lt NAV BSPC
                                                                             &kp C_MUTE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        NUM_layer {
            label = "NUM";

            bindings = <
                 &kp ESC    &kp PIPE   &kp UP     &trans     &kp DE_LBRC    &kp DE_RBRC  &kp N7        &kp N8    &kp N9  &kp DE_PLUS
                 &kp LSHFT  &kp LEFT   &kp DOWN   &kp RIGHT  &kp DE_LBKT    &kp DE_RBKT  &kp N4        &kp N5    &kp N6  &kp DE_MINUS
                 &kp DEL    &kp PG_UP  &kp LC(C)  &kp LC(V)  &kp DE_LPAR    &kp DE_RPAR  &kp N1        &kp N2    &kp N3  &kp DOT
                                                  &trans     &trans         &kp N0       &kp BSPC
                                                                     &trans
            >;
        };

        nav_layer {
            label = "NAV";

            bindings = <
        &kp DE_EXCL      &kp DE_AT  &kp DE_HASH  &kp DE_DLLR  &kp DE_PRCNT    &kp DE_GRAVE     &kp DE_AMPS    &kp DE_EURO     &kp DE_EQUAL     &kp DE_ASTRK
        &kp DE_A_UMLAUT  &kp DE_SZ  &trans       &kp DE_LT    &kp DE_GT       &kp DE_U_UMLAUT  &kp DE_DEGREE  &trans          &kp DE_O_UMLAUT  &kp DE_O_UMLAUT
        &trans           &trans     &kp LC(C)    &kp LC(V)    &kp C_MUTE      &kp C_VOL_DN     &kp C_VOL_UP   &kp C_PREVIOUS  &kp C_NEXT       &kp DE_BSLH
                                                 &mo BT       &kp DE_A        &trans           &trans
                                                                     &trans
            >;
        };

        BASE_mac {
            label = "BASE_MAC";

            bindings = <
                 &kp Q               &kp W           &kp E               &kp R             &kp T        &kp DE_Z   &kp U              &kp I                   &kp O            &kp P
                 &hl LEFT_CONTROL A  &hl LEFT_ALT S  &hl LEFT_COMMAND D  &hl LEFT_SHIFT F  &kp G        &kp H      &hr RIGHT_SHIFT J  &hr RIGHT_COMMAND DE_K  &hr RIGHT_ALT L  &hr RIGHT_CONTROL DE_SEMI
                 &kp DE_Y            &kp X           &kp C               &kp V             &kp B        &kp N      &kp M              &kp DE_COMMA            &kp DE_DOT       &kp DE_FSLH
                                                                         &lt NUM_MAC TAB   &kp SPACE    &kp ENTER  &lt SYM_MAC BSPC
                                                                                              &kp C_MUTE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        NUM_mac {
            label = "NUM_MAC";

            bindings = <
                 &kp ESCAPE      &kp LA(N7)      &kp UP          &trans           &kp LA(NUMBER_8)           &kp LA(N9)                &kp NUMBER_7       &kp N8         &kp N9        &kp DE_PLUS
                 &kp LEFT_SHIFT  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp DE_LEFT_BRACKET        &kp DE_RIGHT_BRACKET      &kp NUMBER_4       &kp NUMBER_5   &kp NUMBER_6  &kp DE_MINUS
                 &kp DELETE      &trans          &kp LG(C)       &kp LG(V)        &kp DE_LEFT_PARENTHESIS    &kp DE_RIGHT_PARENTHESIS  &kp NUMBER_1       &kp N2         &kp NUMBER_3  &kp DE_DOT
                                                                 &trans           &trans                     &kp NUMBER_0              &kp BACKSPACE
                                                                                                     &trans
            >;
        };

        SYM_mac {
            label = "SYM_MAC";

            bindings = <
        &kp DE_EXCL      &kp RA(L)  &kp DE_HASH  &kp DE_DLLR  &kp DE_PRCNT    &kp DE_GRAVE     &kp DE_AMPS   &kp RA(E)       &kp DE_EQUAL     &kp DE_ASTRK
        &kp DE_A_UMLAUT  &kp DE_SZ  &trans       &kp DE_LT    &kp DE_GT       &kp DE_U_UMLAUT  &trans        &trans          &kp DE_O_UMLAUT  &kp DE_O_UMLAUT
        &trans           &trans     &kp LC(C)    &kp LC(V)    &kp C_MUTE      &kp C_VOL_DN     &kp C_VOL_UP  &kp C_PREVIOUS  &kp C_NEXT       &kp RA(RS(N7))
                                                 &mo BT       &kp DE_A        &trans           &trans
                                                                     &trans
            >;
        };

        BT_layer {
            label = "BT";

            bindings = <
       &sys_reset   &trans  &trans   &to BASE_MAC  &to BASE     &trans  &kp F7  &kp F8  &kp F9  &kp F12
       &trans       &trans  &trans   &trans        &trans       &trans  &kp F4  &kp F5  &kp F6  &kp F11
       &trans       &trans  &trans   &trans        &trans       &trans  &kp F1  &kp F2  &kp F3  &kp F10
                                     &trans        &trans       &trans  &trans
                                                         &trans
            >;
        };
    };
};
